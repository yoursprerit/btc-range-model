{
  "_comment": "Copy to deploy/ibkr_accounts.json (git-ignored) and edit. One IB Gateway LIVE login, several accounts under it. Every account trades the same signed live book (data/overall/target_book_live.json) as MARKET-ON-CLOSE orders only.",

  "host": "127.0.0.1",
  "port": 4001,
  "client_id_base": 40,
  "book": "data/overall/target_book_live.json",
