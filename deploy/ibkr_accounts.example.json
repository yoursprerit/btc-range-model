  "child_timeout_s": 3900,
  "stagger_s": 10,
  "market_data_type": 1,

  "defaults": {
    "band": 0.01,
    "max_deploy_frac": 0.25,
    "max_order_notional": 5000,
    "max_gross_frac": 1.02,
    "max_turnover_frac": 1.5,
    "max_price_drift": 0.25
  },

  "accounts": [
    {
      "id": "U1111111",
      "label": "Taxable margin",
      "type": "margin",
      "expected_profile": "Balanced",
      "enabled": true
    },
    {
      "id": "U2222222",
      "label": "Roth IRA",
      "type": "ira",
      "enabled": true,
      "max_order_notional": 3000
    },
    {
      "id": "U3333333",
      "label": "Traditional IRA (paused)",
      "type": "ira",
      "enabled": false
    }
  ]
