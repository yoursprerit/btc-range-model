# Fire the daily executor in the trading afternoon.
[Unit]
Description=Run the IBKR Option C executor weekday afternoons (2:30 PM US Central)

[Timer]
# 14:30 America/Chicago, Mon–Fri — 2:30 PM US Central (3:30 PM ET), 30 minutes
# before the 3:00-PM-CT / 4:00-PM-ET equity close, and hours after the cloud
# publisher committed the morning's book. The timezone suffix needs systemd
# v252+ (Ubuntu 24.04 has it); on older systemd set the host timezone to
# America/Chicago (timedatectl set-timezone America/Chicago) and drop the suffix.
OnCalendar=Mon-Fri 14:30 America/Chicago
# Small jitter so many VMs don't hit IBKR at the exact same instant.
RandomizedDelaySec=90
# Do NOT catch up a missed run hours later (would trade at the wrong time); the
# executor's own guards keep any run safe, but skipping is the sane default.
Persistent=false

[Install]
WantedBy=timers.target
