# LIVE executor env — copy to `executor-live.env` and fill in. Referenced by a
# PARALLEL set of systemd units (see docs/LIVE_TRADING.md). Real money — read that
# doc first. NEVER commit the filled-in file (it is gitignored).
#
# To run paper AND live side by side, create a second executor unit that uses
# this env file instead of executor.env:
#   sudo cp /etc/systemd/system/ibkr-executor.service /etc/systemd/system/ibkr-executor-live.service
#   sudo cp /etc/systemd/system/ibkr-executor.timer   /etc/systemd/system/ibkr-executor-live.timer
#   # edit the .service EnvironmentFile → …/deploy/systemd/executor-live.env
#   sudo systemctl daemon-reload && sudo systemctl enable --now ibkr-executor-live.timer

# Same signing secret as paper (verifies the same target book).
OVERALL_BOOK_SECRET=your-shared-secret

# LIVE gateway API port (docker live service → 4003).
IBKR_PORT=4003

# THE key live switch — turns on --account-mode live + --confirm-live in the wrapper.
IBKR_ACCOUNT_MODE=live

# Pin the EXACT live account id — the run aborts if the connected account differs.
# Find it in IB Gateway / Client Portal (e.g. U1234567). STRONGLY recommended.
IBKR_EXPECTED_ACCOUNT=U1234567

# Safety limits (your chosen starting caps):
IBKR_MAX_DEPLOY_FRAC=0.25          # deploy at most 25% of net-liq; rest stays cash
IBKR_MAX_ORDER_NOTIONAL=5000       # clamp any single order to $5,000 (fat-finger backstop)

# Optional instant halt: create this file to stop live trading on the next run.
IBKR_KILL_SWITCH_FILE=/home/ubuntu/btc-range-model/STOP_LIVE

# Optional failure/health webhook (Slack/Discord/generic).
IBKR_ALERT_WEBHOOK=

# Order routing (see IBKR_PAPER_TRADING.md § "Order routing"). Default is
# marketable-limit: a limit priced 0.5% through the touch, which fills like a
# market order but caps what a stale quote or a bad print can cost — worth
# keeping on live even after you trust the flow. moc fills in the 4:00 PM ET
# closing auction instead (the price the backtest books against); the executor
# then holds until the auction prints, so keep TimeoutStartSec above ~35 min.
# IBKR_ORDER_TYPE=marketable-limit
# IBKR_SLIPPAGE_CAP=0.005

# Market-stress & execution-quality guards (docs/LIVE_TRADING.md). Defaults shown;
# 0 disables a guard. The scheduled wrappers inherit these from the environment.
# IBKR_MAX_SPREAD=0.02            # skip a BUY into a spread wider than 2% (sells 4%) / crossed / halted
# IBKR_MAX_FILL_SLIPPAGE=0.01     # sell fills >1% through the touch -> no buys
# IBKR_STRESS_SPY_MOVE=0.08       # |SPY vs prior close| > 8% -> no buys
# IBKR_STRESS_VIX=50              # VIX > 50 -> no buys
# IBKR_STRESS_NAME_MOVE=0.40      # an ordered name moved >40% -> skip its buy
# IBKR_MAX_NAV_DROP=0.15          # net-liq >15% under the last report -> de-risk only
# IBKR_MIN_MARGIN_CUSHION=0.05     # abort when excess liquidity <= 0 or < 5% of net-liq
