# Copy to `executor.env` (same dir) and fill in. Referenced by the systemd units
# via EnvironmentFile=. NEVER commit the filled-in executor.env — it holds your
# signing secret (it is gitignored).
#
# systemd EnvironmentFile format: KEY=VALUE, one per line, NO `export`, no quotes
# needed unless the value contains spaces.

# Shared HMAC secret — MUST match the publisher (GitHub repo secret) and the
# Streamlit app, so the book's signature verifies before any order.
OVERALL_BOOK_SECRET=your-shared-secret

# Paper API port exposed by the Docker gateway (paper→4004 by default).
IBKR_PORT=4004

# Optional: a webhook URL for failure/health alerts (Slack / Discord / generic).
# Leave blank to log to journald only.
IBKR_ALERT_WEBHOOK=

# Optional passthroughs for scripts/ibkr_execute_daily.sh:
# IBKR_BRANCH=main
# IBKR_BAND=0.01
# IBKR_EXTRA=--fractional

# Order routing. Default is marketable-limit: a limit priced 0.5% through the
# touch, so fills behave like market orders but a bad quote can't run away with
# the order. Set moc to fill in the 4:00 PM ET closing auction instead — the
# price the engine/backtest books against (the executor then holds the
# connection open until the auction prints, ~30 min at the 2:30-PM-CT slot).
# IBKR_ORDER_TYPE=marketable-limit
# IBKR_SLIPPAGE_CAP=0.005

# Market-stress & execution-quality guards (docs/LIVE_TRADING.md). Defaults shown;
# 0 disables a guard. The scheduled wrappers inherit these from the environment.
# IBKR_MAX_SPREAD=0.02            # skip a BUY into a spread wider than 2% (sells 4%) / crossed / halted
# IBKR_MAX_FILL_SLIPPAGE=0.01     # sell fills >1% through the touch -> no buys
# IBKR_STRESS_SPY_MOVE=0.08       # |SPY vs prior close| > 8% -> no buys
# IBKR_STRESS_VIX=50              # VIX > 50 -> no buys
# IBKR_STRESS_NAME_MOVE=0.40      # an ordered name moved >40% -> skip its buy
# IBKR_MAX_NAV_DROP=0.15          # net-liq >15% under the last report -> de-risk only
