# Copy to `.env` (same directory) and fill in — docker compose reads it automatically.
# NEVER commit the filled-in .env: it holds your IBKR paper password.
# .env is gitignored (see repo .gitignore).

# IBKR PAPER credentials. Strongly recommended: a STANDALONE paper account with
# two-factor auth DISABLED, so IBC can log in unattended (mandatory 2FA is what
# breaks headless automation).
TWS_USERID=your_paper_username
TWS_PASSWORD=your_paper_password
